# ==========================================# Tech Trend Hub - Environment Configuration# ==========================================
# ------------------------------------------# WhatsApp Automation# ------------------------------------------WHATSAPP_PHONE_NUMBER=60166787883WHATSAPP_API_KEY=your_whatsapp_api_key_hereWHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_idWHATSAPP_TEMPLATE_ORDER=Hi, I want to order [PRODUCT_NAME] (#[ITEM_NUMBER]). Please provide payment details and delivery options.WHATSAPP_TEMPLATE_BULK=Hi, I'm interested in bulk wholesale orders. Can you provide pricing and MOQ details?
# ------------------------------------------# Social Media APIs (TikTok & Instagram)# ------------------------------------------TIKTOK_API_KEY=your_tiktok_api_keyTIKTOK_API_SECRET=your_tiktok_api_secretTIKTOK_ACCESS_TOKEN=your_tiktok_access_tokenINSTAGRAM_GRAPH_API_TOKEN=your_ig_graph_api_tokenINSTAGRAM_BUSINESS_ACCOUNT_ID=your_ig_business_account_id
# ------------------------------------------# Google Merchant Center# ------------------------------------------GMC_MERCHANT_ID=your_merchant_idGMC_SERVICE_ACCOUNT_EMAIL=your_service_account@project.iam.gserviceaccount.comGMC_PRIVATE_KEY_PATH=./path/to/your/private-key.jsonGMC_FEED_URL=https://techtrendhub.my/api/gmc-feed.xml
# ------------------------------------------# Security & Encryption# ------------------------------------------JWT_SECRET=your_super_secret_jwt_key_change_in_productionENCRYPTION_KEY=your_32_character_encryption_key
# ------------------------------------------# Email Notifications (SMTP)# ------------------------------------------SMTP_HOST=smtp.yourprovider.comSMTP_PORT=587SMTP_USER=your_smtp_userSMTP_PASS=your_smtp_passwordNOTIFICATION_EMAIL=alerts@techtrendhub.my
# ------------------------------------------# Database Configuration (Optional)# ------------------------------------------DATABASE_URL=postgresql://user:password@localhost:5432/techtrendhub
# ------------------------------------------# Automation Settings# ------------------------------------------ENABLE_AUTO_POSTING=trueENABLE_GMC_FEED_GEN=truePOLLING_INTERVAL_MS=60000
