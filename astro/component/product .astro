astro---
import MainLayout from '../../layouts/MainLayout.astro';
import { MessageCircle, Shield, Truck, MapPin, Star } from 'lucide-astro';

const productName = "Premium Screen Protector";
const itemNumber = "SP-GEN-001";
const whatsappPhone = "60166787883";

const protectorTypes = [
  { id: 1, name: "Ultra Clear Standard", color: "from-blue-500 to-blue-600" },
  { id: 2, name: "Anti-Glare HD", color: "from-red-500 to-red-600" },
  { id: 3, name: "Privacy Shield", color: "from-black to-gray-800" },
  { id: 4, name: "Ultra Durable Pro", color: "from-green-500 to-green-600" },
  { id: 5, name: "Curved Edge Premium", color: "from-purple-500 to-purple-600" },
  { id: 6, name: "Oleophobic Coating", color: "from-yellow-500 to-yellow-600" },
  { id: 7, name: "Matte Finish Pro", color: "from-pink-500 to-pink-600" },
  { id: 8, name: "Full Screen Coverage", color: "from-teal-500 to-teal-600" },
  { id: 9, name: "Impact Shield Extreme", color: "from-orange-500 to-orange-600" },
  { id: 10, name: "Premium Ultra Thin", color: "from-indigo-500 to-indigo-600" }
];
---

<MainLayout title={productName}>
  <div class="max-w-7xl mx-auto px-4 py-8 sm:px-6 lg:px-8">
    
    {/* ============================== */}
    {/* Product Summary Section        */}
    {/* ============================== */}
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-12">
      {/* Left: Product Image Placeholder */}
      <div class="md:col-span-1">
        <div class="aspect-square bg-gradient-to-br from-gray-100 to-gray-200 rounded-2xl flex items-center justify-center border border-border">
          <Shield class="w-24 h-24 text-primary opacity-50" />
        </div>
      </div>

      {/* Right: Product Info */}
      <div class="md:col-span-2">
        <h1 class="text-3xl md:text-4xl font-bold text-secondary mb-4">
          {productName}
        </h1>
        <div class="mb-6 space-y-2">
          <p class="text-4xl md:text-5xl font-bold text-primary mb-2">
            RM30 <span class="text-lg text-gray-600 line-through font-normal">per piece</span>
          </p>
          <p class="text-2xl font-bold text-primary mb-4 flex items-center gap-2">
            2 for RM30 <Star class="w-6 h-6 text-yellow-500 fill-yellow-500" /> Wholesaler friendly pricing
          </p>
        </div>
        
        <div class="bg-primary/10 border-2 border-primary rounded-lg p-4 mb-6">
          <p class="text-base text-secondary font-semibold flex items-center gap-2">
            💼 Wholesale Welcome: Price Worth It! Special bulk rates for resellers.
          </p>
        </div>
        
        <div class="space-y-3 text-gray-700">
          <p class="flex items-center gap-2"><MapPin class="w-5 h-5 text-primary" /> <span class="font-semibold">Delivery:</span> Shah Alam (Self-pickup available)</p>
          <p class="flex items-center gap-2"><Truck class="w-5 h-5 text-primary" /> <span class="font-semibold">Shipping:</span> Fast shipping throughout West Malaysia</p>
          <p class="flex items-center gap-2"><Shield class="w-5 h-5 text-primary" /> <span class="font-semibold">Quality:</span> Premium tempered glass with crystal clarity</p>
        </div>
      </div>
    </div>

    {/* ============================== */}
    {/* Product Styles/Variants Section*/}
    {/* ============================== */}
    <div class="mb-12">
      <h2 class="text-2xl font-bold text-secondary mb-2">Choose Your Type</h2>
      <p class="text-gray-600 mb-6">Select from our 10 premium screen protector designs</p>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {protectorTypes.map((type) => (
          <div class="group bg-white rounded-xl overflow-hidden border border-border hover:shadow-lg transition-all duration-300 cursor-pointer" data-type-id={type.id} data-type-name={type.name}>
            <div class={`h-48 bg-gradient-to-br ${type.color} flex items-center justify-center text-white text-5xl font-bold relative`}>
              {type.id}
              <div class="absolute top-3 right-3 bg-white/90 text-secondary rounded-lg px-2 py-1 text-xs font-bold backdrop-blur-sm">↗</div>
            </div>
            <div class="p-4 text-center">
              <button class="w-full bg-secondary text-white font-bold py-3 px-4 rounded-lg hover:bg-secondary/90 transition-all text-center group-hover:bg-primary">
                {type.name}
              </button>
            </div>
          </div>
        ))}
      </div>
    </div>

    {/* ============================== */}
    {/* Options & Specifications       */}
    {/* ============================== */}
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-12">
      <div class="lg:col-span-2">
        <h2 class="text-2xl font-bold text-secondary mb-6">选择规格 (Select Options)</h2>
        
        {/* Protector Type Options */}
        <div class="mb-10">
          <div class="flex items-center justify-between mb-4">
            <label class="text-lg font-semibold text-secondary">Protector Type</label>
            <span class="text-sm text-gray-500">Required</span>
          </div>
          <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-3" id="type-selector">
            {protectorTypes.map((type) => (
              <button 
                type="button"
                class="type-btn border-2 border-border rounded-lg py-2 px-3 text-center hover:border-primary transition-colors font-semibold text-secondary hover:bg-primary hover:text-white data-[selected=true]:bg-primary data-[selected=true]:text-white data-[selected=true]:border-primary"
                data-type-id={type.id}
                data-type-name={type.name}
              >
                {type.name}
              </button>
            ))}
          </div>
        </div>

        {/* Quantity Section */}
        <div class="border-t pt-8">
          <div class="flex items-center justify-between mb-6">
            <label class="text-lg font-semibold text-secondary">Quantity (Pieces)</label>
            <span class="text-sm text-gray-500">Minimum: 2</span>
          </div>
          <div class="flex items-center gap-4 max-w-xs">
            <button type="button" id="qty-minus" class="border-2 border-border rounded-lg w-12 h-12 flex items-center justify-center text-lg hover:border-primary transition-colors font-bold">−</button>
            <input type="number" id="qty-input" value="2" min="2" class="flex-1 border-2 border-border rounded-lg px-4 py-2 text-center text-lg font-semibold focus:outline-none focus:border-primary" />
            <button type="button" id="qty-plus" class="border-2 border-border rounded-lg w-12 h-12 flex items-center justify-center text-lg hover:border-primary transition-colors font-bold">+</button>
          </div>
        </div>
      </div>

      {/* Order Summary Section */}
      <div class="lg:col-span-1">
        <div class="bg-white rounded-lg border border-border p-6 sticky top-20 shadow-sm">
          <h3 class="text-xl font-bold text-secondary mb-4">Order Summary</h3>
          
          <div class="mb-6 space-y-2 text-sm text-gray-600">
            <p class="flex items-center gap-2"><MapPin class="w-4 h-4" /> Shah Alam, Malaysia</p>
            <p class="flex items-center gap-2 text-green-600"><span class="text-lg">✓</span> Self-pickup available</p>
            <p class="flex items-center gap-2 text-green-600"><span class="text-lg">✓</span> Fast shipping within West Malaysia</p>
            <p class="flex items-center gap-2 text-green-600"><span class="text-lg">✓</span> Special bulk rates for wholesalers</p>
          </div>

          <div class="space-y-4 border-t pt-4">
            <div class="flex justify-between">
              <span class="text-gray-600">Protector Type:</span>
              <span id="summary-type" class="font-semibold text-secondary">Not selected</span>
            </div>
            <div class="flex justify-between">
              <span class="text-gray-600">Quantity:</span>
              <span id="summary-qty" class="font-semibold text-secondary">2 pieces</span>
            </div>
            <div class="border-t pt-4 flex justify-between items-end">
              <span class="text-lg font-bold text-secondary">Total Price:</span>
              <span id="summary-total" class="text-3xl font-bold text-primary">RM 30.00</span>
            </div>
            <p class="text-xs text-gray-500 text-center">
              Final price may vary based on shipping and bulk discounts.
            </p>
          </div>

          {/* Dynamic WhatsApp Order Button */}
          <div class="mt-6">
            <a 
              id="whatsapp-btn"
              href="#"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-center gap-2 w-full bg-green-600 text-white font-bold py-4 px-6 rounded-lg hover:bg-green-700 transition-all text-lg shadow-md hover:shadow-lg"
            >
              <MessageCircle class="w-6 h-6" />
              确定 (Confirm Order via WhatsApp)
            </a>
          </div>
        </div>
      </div>
    </div>

  </div>

  {/* ============================== */}
  {/* Client-side Interactivity      */}
  {/* ============================== */}
  <script>
    const productName = "Premium Screen Protector";
    const itemNumber = "SP-GEN-001";
    const whatsappPhone = "60166787883";

    const typeBtns = document.querySelectorAll('.type-btn');
    const qtyMinus = document.getElementById('qty-minus');
    const qtyPlus = document.getElementById('qty-plus');
    const qtyInput = document.getElementById('qty-input');
    
    const summaryType = document.getElementById('summary-type');
    const summaryQty = document.getElementById('summary-qty');
    const summaryTotal = document.getElementById('summary-total');
    const whatsappBtn = document.getElementById('whatsapp-btn');

    let selectedType = "Not selected";
    let quantity = 2;

    function updateSummary() {
      // Update UI Text
      summaryType.textContent = selectedType;
      summaryQty.textContent = `${quantity} pieces`;
      
      // Calculate total: "2 for RM30" implies RM15 per piece at wholesale rate
      const totalPrice = quantity * 15; 
      summaryTotal.textContent = `RM ${totalPrice.toFixed(2)}`;

      // Generate Dynamic WhatsApp Link (URL Encoded)
      const message = `Hi, I want to order ${productName} (#${itemNumber}).\n\n` +
                      `📦 Type: ${selectedType}\n` +
                      `🔢 Quantity: ${quantity} pieces\n` +
                      `💰 Estimated Total: RM ${totalPrice.toFixed(2)}\n\n` +
                      `Please provide payment details and delivery options.`;
      
      whatsappBtn.href = `https://wa.me/${whatsappPhone}?text=${encodeURIComponent(message)}`;
    }

    // Type Selection Logic
    typeBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        typeBtns.forEach(b => b.setAttribute('data-selected', 'false'));
        btn.setAttribute('data-selected', 'true');
        selectedType = btn.getAttribute('data-type-name');
        updateSummary();
      });
    });

    // Quantity Logic
    qtyMinus.addEventListener('click', () => {
      if (quantity > 2) {
        quantity--;
        qtyInput.value = quantity;
        updateSummary();
      }
    });

    qtyPlus.addEventListener('click', () => {
      quantity++;
      qtyInput.value = quantity;
      updateSummary();
    });

    qtyInput.addEventListener('change', (e) => {
      let val = parseInt(e.target.value);
      if (isNaN(val) || val < 2) val = 2;
      quantity = val;
      e.target.value = quantity;
      updateSummary();
    });

    // Initialize on load
    updateSummary();
  </script>
</MainLayout>
